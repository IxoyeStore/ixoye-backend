{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "productName": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "productName",
      "required": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "productType": {
      "type": "string",
      "required": false
    },
    "vehicleType": {
      "type": "string",
      "required": false
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "wholesalePrice": {
      "type": "decimal",
      "required": false
    },
    "stock": {
      "type": "integer",
      "default": 0
    },
    "images": {
      "type": "json"
    },
    "brand": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "motors": {
      "type": "string"
    },
    "oemCode": {
      "type": "string",
      "required": false
    },
    "applications": {
      "type": "json"
    },
    "fitMakes": {
      "type": "text"
    },
    "fitSeries": {
      "type": "text"
    },
    "fitModels": {
      "type": "text"
    },
    "fitEngines": {
      "type": "text"
    },
    "fitVehicles": {
      "type": "text"
    },
    "oemNumbers": {
      "type": "text"
    },
    "imageCode": {
      "type": "string",
      "required": false
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "freeShipping": {
      "type": "boolean",
      "default": false
    },
    "questions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::question.question",
      "mappedBy": "product"
    }
  }
}
